{{{
  exports({ to: app.configPath(fileName) })
}}}
import env from '#start/env'
import { defineConfig } from '@ordius/adonisjs-shortlink'
import type { InferShortlinkModel } from '@ordius/adonisjs-shortlink/types'

const shortlinkConfig = defineConfig({
  /*
  |--------------------------------------------------------------------------
  | Shortlink Model
  |--------------------------------------------------------------------------
  |
  | Imported lazily so resolving this config doesn't eagerly load the
  | model (and its imports).
  |
  */
  model: () => import('#models/shortlink'),

  /*
  |--------------------------------------------------------------------------
  | Domain
  |--------------------------------------------------------------------------
  |
  | The primary domain shortlinks are served from. Add more hosts via
  | "domains" below if you need to serve the same slugs from several
  | domains.
  |
  */
  domain: env.get('SHORTLINK_DOMAIN'),

  // domains: ['legacy-short.example.com'],
  // protocol: 'https',
  // prefix: 's',

  /*
  |--------------------------------------------------------------------------
  | Redirect status code
  |--------------------------------------------------------------------------
  |
  | 302 by default: 301 is cached forever by browsers, so repointing a
  | slug to a new URL would keep redirecting previous visitors to the old
  | destination.
  |
  */
  // redirectStatusCode: 302,
  // trackClicks: true,

  // slug: {
  //   length: 8,
  //   maxAttempts: 5,
  //   reserved: ['api', 'admin'],
  // },

  // allowedProtocols: ['http:', 'https:'],
})

export default shortlinkConfig

/**
 * Types the "shortlink" service (and container binding) with the model
 * configured above.
 */
declare module '@ordius/adonisjs-shortlink/types' {
  interface ShortlinkModels extends InferShortlinkModel<typeof shortlinkConfig> {}
}
